# Postgres (outside Docker). docker-compose.yml sets its own DATABASE_URL for the api container.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tagging

# Web app sign-in: the first account, created on startup if missing
EMAIL=admin@distilliq.com
PASSWORD=ChangeMe123!
FIRST_NAME=Olivia
LAST_NAME=Rhye
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5175

# AWS Athena: the topk_options table copied by Refresh
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ATHENA_WORKGROUP=proximo
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/
ATHENA_CATALOG=AwsDataCatalog
ATHENA_DATABASE=dev_proximo_cantag
ATHENA_TABLE=topk_options

# Records tagged at once
TAG_WORKERS=4
